\ProvidesPackage{styles/tikz_setup}[2026/04/12 Custom TikZ Commands and Packages]
\RequirePackage{tikz}

% 可換図矢印
\usetikzlibrary{arrows.meta}

% 矢印を追加するためのライブラリ
\usetikzlibrary{decorations.markings}

% 計算
\RequirePackage{calc}

% より一般的な計算
\usetikzlibrary{math}

% 位置計算 図形計算
\usetikzlibrary{positioning, intersections, through, angles, quotes}

% 
\usetikzlibrary {datavisualization.formats.functions}

% 樹形図
\usetikzlibrary {trees}
\usetikzlibrary{mindmap}


% 
% \usetikzlibrary{tikzcd}

% multi part
\usetikzlibrary {shapes.multipart}

% オートマタ
\usetikzlibrary {automata}

% fill pattern
\usetikzlibrary{patterns}

% 波線
\usetikzlibrary{decorations.pathmorphing}

% その他装飾線
\usetikzlibrary {decorations.pathreplacing, decorations.shapes}

% 影
\usetikzlibrary{shadows}

% グラフ
\usetikzlibrary{graphs}

% 電気回路図
\usetikzlibrary {circuits.ee.IEC}

% 論理回路図
\usetikzlibrary{circuits.logic.US}

% \usetikzlibrary {graphdrawing} 
% \usegdlibrary {force}

% 指定点を通る円
\usetikzlibrary{through}

% 拡大
\usetikzlibrary{spy}

% フラクタルを描く
\usetikzlibrary{decorations.fractals}

% 3次元
\usetikzlibrary {3d}

% 3次元視点
\usetikzlibrary{perspective}

% カレンダー
\usetikzlibrary {calendar}

\usetikzlibrary{shapes.misc}


\usetikzlibrary {decorations.text}



